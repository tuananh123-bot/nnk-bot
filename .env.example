# =================================================================
# NENEKA AUTONOMOUS DISCORD AI - ENVIRONMENT CONFIGURATION
# =================================================================

# Discord Bot Credentials
DISCORD_TOKEN=your_discord_bot_token_here
AUTO_REPLY_CHANNELS=1546061652967948358
CHOSEN_ONE_NAME=Kishi-kun
CREATOR_USER_ID=483169533922639902
MAX_BOND_USER_IDS=864077473661845504

# Custom Emoji Source Server (Ưu tiên server 1169588792064217159)
EMOJI_SOURCE_GUILD_ID=1169588792064217159,413766882277982228
EMOJI_SOURCE_INVITE_URL=https://discord.gg/BJTm5Zsjm

# Groq LLM API (Fast Chat & Code - Free tại https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Ultra-Fast Chat APIs (Tùy chọn - Free Tier tốc độ ~2200 tok/s)
# Đăng ký Free tại: https://cloud.cerebras.ai (1M tokens/ngày) & https://cloud.sambanova.ai
CEREBRAS_API_KEY=
CEREBRAS_CHAT_MODEL=qwen-3-32b
SAMBANOVA_API_KEY=
SAMBANOVA_CHAT_MODEL=Meta-Llama-3.3-70B-Instruct

# Free Fast Coding APIs (Tùy chọn - Chuyên đọc & viết code siêu nhanh miễn phí)
# Đăng ký Mistral Codestral Free tại: https://console.mistral.ai/codestral
CODESTRAL_API_KEY=
CODESTRAL_MODEL=codestral-latest
OPENROUTER_API_KEY=
OPENROUTER_CODE_MODEL=qwen/qwen3-coder:free

# Google Gemini API (Vision, Đọc GIF, Nano Banana Image Gen & Fast Chat Backup)
GEMINI_API_KEY=AIzaSy...
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# NSFW Mode (18+ content)
NSFW_ENABLED=false
NSFW_CHANNEL_IDS=

# Database Configuration (PostgreSQL Async / SQLite Fallback)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/neneka_db
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///neneka.db

# Redis Cache & Anti-Spam
REDIS_URL=redis://localhost:6379/0

# Autonomous Behavior Mode: MENTION (Mode A), AUTO_CHAT (Mode B), AUTONOMOUS (Mode C)
AUTONOMOUS_MODE=AUTONOMOUS
CHANNEL_COOLDOWN_SECONDS=3
USER_COOLDOWN_SECONDS=2
PROACTIVE_MIN_INTERVAL_SECONDS=120

# Japanese Voice / TTS Configuration
TTS_PROVIDER=fishaudio
DEFAULT_JAPANESE_VOICE=ja-JP-NanamiNeural
VOICE_PITCH_ADJUST=-14Hz
VOICE_RATE_ADJUST=-6%

# Fish Audio Configuration (https://fish.audio)
FISH_AUDIO_API_KEY=sk-fish-your_api_key_here
FISH_AUDIO_MODEL_ID=5b11a7f1653844048d44a5068859212a

# GPT-SoVITS (Local/Colab)
SOVITS_API_URL=http://127.0.0.1:9880
