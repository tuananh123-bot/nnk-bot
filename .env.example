# =================================================================
# NENEKA AUTONOMOUS DISCORD AI - ENVIRONMENT CONFIGURATION
# =================================================================

# Discord Bot Credentials
DISCORD_TOKEN=your_discord_bot_token_here
AUTO_REPLY_CHANNELS=1546061652967948358
CHOSEN_ONE_NAME=Kishi-kun
CREATOR_USER_ID=483169533922639902
MAX_BOND_USER_IDS=864077473661845504

# Groq LLM API
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini API (Backup / Voice Design / Vision)
GEMINI_API_KEY=AIzaSy...

# OpenRouter API (Multi-model, NSFW-capable)
# Lấy API key tại: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_DEFAULT_MODEL=nousresearch/hermes-3-llama-3.1-405b:nitro

# NSFW Mode (18+ content)
# NSFW_ENABLED=true để bật tính năng, sau đó dùng lệnh /nsfw enable trong kênh cụ thể
NSFW_ENABLED=false
# Comma-separated channel IDs được phép NSFW ngay từ đầu (không cần /nsfw enable)
NSFW_CHANNEL_IDS=

# Database Configuration (PostgreSQL Async)
# Fallback to sqlite+aiosqlite:///neneka.db if PostgreSQL is not available locally
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/neneka_db
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///neneka.db

# Redis Cache & Anti-Spam
REDIS_URL=redis://localhost:6379/0

# Autonomous Behavior Mode: MENTION (Mode A), AUTO_CHAT (Mode B), AUTONOMOUS (Mode C)
AUTONOMOUS_MODE=AUTONOMOUS
CHANNEL_COOLDOWN_SECONDS=3
USER_COOLDOWN_SECONDS=2
PROACTIVE_MIN_INTERVAL_SECONDS=120

# Japanese Voice / TTS Configuration
# Options: fishaudio (High-quality Anime TTS / Clone), edge (free default), gpt_sovits (Local/Colab)
TTS_PROVIDER=fishaudio
DEFAULT_JAPANESE_VOICE=ja-JP-NanamiNeural
VOICE_PITCH_ADJUST=-14Hz
VOICE_RATE_ADJUST=-6%

# Fish Audio Configuration (https://fish.audio)
FISH_AUDIO_API_KEY=sk-fish-your_api_key_here
FISH_AUDIO_MODEL_ID=5b11a7f1653844048d44a5068859212a

# GPT-SoVITS (Dành cho ai tự host mô hình AI clone giọng Neneka)
SOVITS_API_URL=http://127.0.0.1:9880
