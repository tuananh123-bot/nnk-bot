# =================================================================
# NENEKA AUTONOMOUS DISCORD AI - ENVIRONMENT CONFIGURATION
# =================================================================

# Discord Bot Credentials
DISCORD_TOKEN=your_discord_bot_token_here
AUTO_REPLY_CHANNELS=1546061652967948358
CHOSEN_ONE_NAME=Kishi-kun

# Groq LLM API
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini API (Backup / Voice Design)
GEMINI_API_KEY=AIzaSy...

# Database Configuration (PostgreSQL Async)
# Fallback to sqlite+aiosqlite:///neneka.db if PostgreSQL is not available locally
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/neneka_db
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///neneka.db

# Redis Cache & Anti-Spam
REDIS_URL=redis://localhost:6379/0

# Autonomous Behavior Mode: MENTION (Mode A), AUTO_CHAT (Mode B), AUTONOMOUS (Mode C)
AUTONOMOUS_MODE=AUTONOMOUS
CHANNEL_COOLDOWN_SECONDS=3
USER_COOLDOWN_SECONDS=2
PROACTIVE_MIN_INTERVAL_SECONDS=120

# Japanese Voice / TTS Configuration
# Options: edge (free default), elevenlabs (Instant Voice Clone from recording), gpt_sovits (Local/Colab)
TTS_PROVIDER=edge
DEFAULT_JAPANESE_VOICE=ja-JP-NanamiNeural
VOICE_PITCH_ADJUST=-14Hz
VOICE_RATE_ADJUST=-6%

# ElevenLabs Voice Cloning (Để giọng giống hệt file ghi âm Neneka)
# Tạo Instant Voice Clone bằng file assets/voice_samples/neneka_sample_short.mp3
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# GPT-SoVITS (Dành cho ai tự host mô hình AI clone giọng Neneka miễn phí)
SOVITS_API_URL=http://127.0.0.1:9880
